{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewed_base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "outcome": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED", "INCOMPLETE"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "files_reviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "maxItems": 100
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": ["met", "unmet", "unverified"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["id", "status", "evidence"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "side": {
            "type": "string",
            "enum": ["base", "head"]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "priority",
          "title",
          "file",
          "side",
          "line",
          "scenario",
          "impact",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reviewed_base",
    "reviewed_head",
    "outcome",
    "summary",
    "files_reviewed",
    "acceptance",
    "findings"
  ],
  "additionalProperties": false
}
